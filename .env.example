# Server & Network Configuration
PORT=3000
FRONTEND_PORT=4200
NODE_ENV=development
PRODUCTION=false
PROJECT_NAME=teslaroadtrips
SESSION_SECRET=change-this-to-a-secure-random-secret-key-in-production

# MongoDB Database Connection
# Atlas Connection String (e.g. mongodb+srv://<user>:<password>@cluster0.mongodb.net/teslaroadtrips?retryWrites=true&w=majority)
# Or local instance: mongodb://localhost:27017/teslaroadtrips
MONGODB_URI=mongodb://localhost:27017/teslaroadtrips

# AI Planning Configuration (OpenAI, OpenRouter, Groq, or DeepSeek compatible)
AI_API_KEY=your_ai_api_key_here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Daily Trip Plan Rate Limit (per user IP address per calendar day)
DAILY_PLAN_LIMIT=20
